    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,design_handoff/**,build/**,data/**,.garmintokens/**,dashboard.py,**/__pycache__/**,**/*.pyc,*.db}"
    }
  },
  "crons": [
    {
