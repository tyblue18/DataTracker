# Copy this file to ".env" and fill in your Garmin Connect credentials.
# The .env file is gitignored and never committed.

GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password

# Where the OAuth tokens are cached after first login (so you don't log in every time).
# Default is a ".garmintokens" folder inside this project.
GARMINTOKENS=.garmintokens

# Where the local SQLite database lives.
GARMIN_DB=data/garmin.db

# --- Goal race (optional) ---------------------------------------------------
# Drives the countdown badge and the race-day fitness/form projection.
GARMIN_RACE_DATE=2026-09-13
GARMIN_RACE_NAME=Ironman Wales

# --- Scoring (optional) -----------------------------------------------------
# Sessions per week the Consistency pillar aims for.
GARMIN_WEEKLY_SESSIONS=6

# --- Strength import (optional) ---------------------------------------------
# Exported Que localStorage JSON. In the Que web app, open DevTools and run
#   copy(localStorage.getItem('ironmanCoreDB_v2'))
# then paste the result into this file.
QUE_EXPORT_PATH=data/que_export.json

# --- Hosting (see DEPLOY.md) ------------------------------------------------
# Unlocks the "Sync now" button and /api/snapshot for you. The dashboard itself
# is public, so leaving this unset means nobody can sync -- including you.
APP_PASSWORD=choose-something-long
# Set to 0 to put the whole page behind APP_PASSWORD instead of just the sync
# button. Default is a publicly readable dashboard.
PUBLIC_DASHBOARD=1
# Protects the scheduled sync endpoint. Generate with: openssl rand -hex 32
CRON_SECRET=
# Postgres for deployment. Unset locally = SQLite at GARMIN_DB.
DATABASE_URL=
# How many days back each sync looks.
SYNC_DAYS=7
